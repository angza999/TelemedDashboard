<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Telemed Dashboard</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'data-quality' }) %>
    <main class="main">
      <header class="topbar">
        <div><p class="eyebrow">Admin · Read-only audit</p><h1><%= title %></h1></div>
        <% if (currentUser) { %>
          <form action="/logout" method="post" class="user-box">
            <span><i class="bi bi-person-circle"></i> <%= currentUser.name %></span>
            <button type="submit" class="icon-button" title="ออกจากระบบ" aria-label="ออกจากระบบ"><i class="bi bi-box-arrow-right"></i></button>
          </form>
        <% } %>
      </header>

      <section class="filter-panel data-quality-filter">
        <form action="/admin/data-quality" method="get" class="filter-grid">
          <label>วันที่เริ่มต้น<input type="date" name="startDate" value="<%= filters.startDate %>"></label>
          <label>วันที่สิ้นสุด<input type="date" name="endDate" value="<%= filters.endDate %>"></label>
          <div class="filter-actions"><button type="submit" class="primary-button"><i class="bi bi-shield-check"></i><span>ตรวจสอบ</span></button></div>
        </form>
        <p class="panel-note">ตรวจจากข้อมูลสรุปเท่านั้น ไม่แสดง HN, VN, CID หรือชื่อผู้ป่วย และไม่มีการเขียนข้อมูลกลับ HOSxP</p>
      </section>

      <% if (error) { %><div class="alert"><%= error %></div><% } %>

      <section class="data-quality-summary" aria-label="สรุปผลการตรวจสอบ">
        <article class="data-quality-summary-item pass"><span>ผ่าน</span><strong><%= report.summary.pass.toLocaleString('th-TH') %></strong><small>รายการ</small></article>
        <article class="data-quality-summary-item warning"><span>คำเตือน</span><strong><%= report.summary.warning.toLocaleString('th-TH') %></strong><small>รายการ</small></article>
        <article class="data-quality-summary-item review"><span>ต้องตรวจสอบ</span><strong><%= report.summary.review.toLocaleString('th-TH') %></strong><small>รายการ</small></article>
      </section>

      <section class="panel data-quality-panel">
        <div class="panel-heading">
          <div><h2>รายการตรวจสอบ</h2><p class="panel-note">แสดงหลักฐานระดับ Aggregate และแนวทางตรวจสอบ WebApp/HOSxP โดยไม่แก้ต้นทาง</p></div>
          <span><i class="bi bi-shield-lock"></i> Admin only</span>
        </div>
        <% if (report.checks.length > 0) { %>
          <div class="table-wrap data-quality-table-wrap">
            <table class="data-quality-table">
              <thead><tr><th>หัวข้อตรวจสอบ</th><th>สถานะ</th><th>หลักฐาน</th><th>แนวทางติดตาม</th></tr></thead>
              <tbody>
                <% report.checks.forEach((check) => { %>
                  <tr>
                    <td><strong><%= check.label %></strong></td>
                    <td><span class="quality-badge <%= check.status %>"><%= check.status === 'pass' ? 'ผ่าน' : (check.status === 'warning' ? 'คำเตือน' : 'ต้องตรวจสอบ') %></span></td>
                    <td><%= check.evidence %></td>
                    <td><%= check.recommendation || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="executive-inline-empty">ยังไม่มีผลตรวจสอบในช่วงวันที่เลือก</div>
        <% } %>
      </section>
    </main>
  </div>
</body>
</html>
