<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Telemed Dashboard</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'executive' }) %>

    <main class="main executive-main">
      <header class="topbar">
        <div>
          <p class="eyebrow">สรุปผลและติดตามเป้าหมาย Telemedicine</p>
          <h1>Executive Dashboard</h1>
        </div>
        <% if (currentUser) { %>
          <form action="/logout" method="post" class="user-box">
            <span><i class="bi bi-person-circle"></i> <%= currentUser.name %></span>
            <button type="submit" class="icon-button" title="ออกจากระบบ" aria-label="ออกจากระบบ">
              <i class="bi bi-box-arrow-right"></i>
            </button>
          </form>
        <% } %>
      </header>

      <div class="executive-tabs" role="tablist" aria-label="Executive Dashboard tabs">
        <button type="button" class="tab-button <%= activeTab === 'overview' ? 'active' : '' %>" data-exec-tab="overview">ภาพรวมผู้บริหาร</button>
        <button type="button" class="tab-button <%= activeTab === 'department-target' ? 'active' : '' %>" data-exec-tab="department-target">เป้าหมายรายห้อง</button>
      </div>

      <section class="tab-panel <%= activeTab === 'overview' ? 'active' : '' %>" data-exec-panel="overview">
        <section class="filter-panel executive-filter-panel">
          <form action="/executive" method="get" class="filter-grid executive-filter">
            <input type="hidden" name="tab" value="overview">
            <label>
              วันที่เริ่มต้น
              <span class="thai-date-control">
                <span data-thai-date-display><%= metrics.startDateLabel %></span>
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                <input type="date" name="startDate" value="<%= filters.startDate %>" aria-label="วันที่เริ่มต้น <%= metrics.startDateLabel %>" data-thai-date-input>
              </span>
            </label>
            <label>
              วันที่สิ้นสุด
              <span class="thai-date-control">
                <span data-thai-date-display><%= metrics.endDateLabel %></span>
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                <input type="date" name="endDate" value="<%= filters.endDate %>" aria-label="วันที่สิ้นสุด <%= metrics.endDateLabel %>" data-thai-date-input>
              </span>
            </label>
            <label>
              แนวโน้ม
              <select name="granularity">
                <option value="day" <%= filters.granularity === 'day' ? 'selected' : '' %>>รายวัน</option>
                <option value="week" <%= filters.granularity === 'week' ? 'selected' : '' %>>รายสัปดาห์</option>
                <option value="month" <%= filters.granularity === 'month' ? 'selected' : '' %>>รายเดือน</option>
              </select>
            </label>
            <div class="filter-actions">
              <button type="submit" class="primary-button" data-executive-submit><i class="bi bi-funnel"></i> <span>แสดงผล</span></button>
              <a class="secondary-button" data-executive-pdf href="/executive/export.pdf?startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>&granularity=<%= filters.granularity %>">
                <i class="bi bi-filetype-pdf"></i>
                <span>ส่งออก PDF</span>
              </a>
            </div>
          </form>
          <p class="executive-period-label"><i class="bi bi-calendar-range"></i> ช่วงข้อมูล <strong><%= metrics.periodLabel %></strong><span>ใช้ช่วงวันที่เดียวกันสำหรับ KPI, แนวโน้ม และรายงาน PDF</span></p>
          <p class="executive-export-status" data-executive-status role="status" aria-live="polite"></p>
        </section>

        <% const performance = metrics.targetPerformance; %>
        <% if (dbError) { %>
          <section class="panel executive-state-panel error" role="alert">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <div><h2>ไม่สามารถโหลดข้อมูล Executive Dashboard ได้</h2><p>กรุณาตรวจสอบการเชื่อมต่อฐานข้อมูลแล้วลองใหม่อีกครั้ง</p></div>
            <a class="secondary-button compact" href="/executive?tab=overview&amp;startDate=<%= filters.startDate %>&amp;endDate=<%= filters.endDate %>&amp;granularity=<%= filters.granularity %>"><i class="bi bi-arrow-clockwise"></i><span>ลองใหม่</span></a>
          </section>
        <% } else if (metrics.total === 0) { %>
          <section class="panel executive-state-panel empty" role="status">
            <i class="bi bi-calendar-x" aria-hidden="true"></i>
            <div><h2>ไม่พบข้อมูลในช่วงวันที่ที่เลือก</h2><p>ลองปรับช่วงวันที่แล้วกดแสดงผลอีกครั้ง</p></div>
          </section>
        <% } else { %>
        <section class="executive-primary-kpis executive-primary-kpis-focused" aria-label="ตัวชี้วัดสำคัญสำหรับผู้บริหาร">
          <article class="executive-primary-kpi primary">
            <p>OPD ห้องที่ประเมิน <i class="bi bi-info-circle" title="รวมเฉพาะห้องที่มีฐาน OPD และข้อมูลพร้อมประเมินเป้าหมาย"></i></p>
            <% if (performance.available) { %><div><strong><%= performance.opdTotal.toLocaleString('th-TH') %></strong><span>ครั้ง</span></div><small>ฐานสำหรับคำนวณเป้าหมายรายห้อง</small><% } else { %><div><strong>-</strong></div><small>ยังไม่สามารถประเมิน</small><% } %>
          </article>
          <article class="executive-primary-kpi primary">
            <p>Telemedicine ที่ใช้ประเมิน <i class="bi bi-info-circle" title="รวมเฉพาะผล Telemedicine ของห้องที่มีข้อมูลพร้อมประเมิน"></i></p>
            <% if (performance.available) { %><div><strong><%= performance.telemedTotal.toLocaleString('th-TH') %></strong><span>ครั้ง</span></div><small>ผลงานจากห้องที่นำมาประเมิน</small><% } else { %><div><strong>-</strong></div><small>ยังไม่สามารถประเมิน</small><% } %>
          </article>
          <article class="executive-primary-kpi primary">
            <p>สัดส่วน Telemedicine ต่อ OPD <i class="bi bi-info-circle" title="Telemedicine ที่ใช้ประเมิน ÷ OPD ห้องที่ประเมิน ไม่ใช่ความคืบหน้าสู่เป้าหมาย"></i></p>
            <% if (performance.available) { %><div><strong><%= performance.rate.toFixed(2) %></strong><span>%</span></div><small>Telemedicine ÷ OPD ห้องที่ประเมิน</small><% } else { %><div><strong>-</strong></div><small>ฐาน OPD เป็นศูนย์หรือไม่มีข้อมูล</small><% } %>
          </article>
          <article class="executive-primary-kpi hospital-total">
            <p>Telemedicine ทั้งโรงพยาบาล</p>
            <div><strong><%= metrics.total.toLocaleString('th-TH') %></strong><span>ครั้ง</span></div>
            <% if (performance.available) { %><small>ในห้องที่ประเมิน <%= performance.telemedTotal.toLocaleString('th-TH') %> ครั้ง · นอกขอบเขต <%= metrics.outsideEvaluationTotal.toLocaleString('th-TH') %> ครั้ง</small><% } else { %><small>รวมทุกแผนกและห้องบริการ</small><% } %>
          </article>
        </section>

        <% const targetProgressRaw = performance.available && performance.targetTotal > 0 ? (performance.telemedTotal / performance.targetTotal) * 100 : 0; const targetProgress = Math.min(Math.max(targetProgressRaw, 0), 100); %>
        <section class="panel executive-target-progress <%= performance.available ? '' : 'unavailable' %>">
          <div class="panel-heading">
            <div><h2>ผลเทียบเป้าหมายรายห้อง</h2><p class="panel-note">สรุปจากห้องบริการที่มีข้อมูลพร้อมประเมิน</p></div>
            <% if (performance.available) { %><strong class="target-progress-percent" title="Telemedicine ที่ใช้ประเมิน ÷ ผลรวมเป้าหมายของแต่ละห้อง">ทำได้ <%= targetProgressRaw.toFixed(1) %>% ของเป้าหมาย</strong><% } %>
          </div>
          <% if (performance.available) { %>
            <div class="target-progress-metrics">
              <div><span>ทำได้</span><strong><%= performance.telemedTotal.toLocaleString('th-TH') %></strong><small>ครั้ง</small></div>
              <div><span>เป้าหมาย <i class="bi bi-info-circle" title="ผลรวม CEIL(OPD ของแต่ละห้อง × เป้าหมายที่กำหนด) จึงอาจต่างจาก OPD รวม × เป้าหมายจากการปัดเศษรายห้อง"></i></span><strong><%= performance.targetTotal.toLocaleString('th-TH') %></strong><small>ครั้ง</small></div>
              <div class="gap"><span>ยังขาดจากเป้าหมาย</span><strong><%= performance.shortage.toLocaleString('th-TH') %></strong><small>ครั้ง</small></div>
            </div>
            <div class="target-progress-track executive-target-track" role="progressbar" aria-label="ความคืบหน้าสู่เป้าหมายรายห้อง" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= targetProgress.toFixed(1) %>" aria-valuetext="ทำได้ <%= targetProgressRaw.toFixed(1) %> เปอร์เซ็นต์ของเป้าหมาย"><span style="width: <%= targetProgress.toFixed(2) %>%"></span></div>
            <div class="target-progress-scale" aria-hidden="true"><span>0%</span><strong><%= targetProgressRaw.toFixed(1) %>%</strong><span>เป้าหมาย 100%</span></div>
            <p class="panel-note">สัดส่วน Telemedicine ต่อ OPD <strong><%= performance.rate.toFixed(2) %>%</strong> · แถบเต็ม 100% หมายถึงทำได้ครบตามเป้าหมายรายห้อง</p>
          <% } else { %><p class="panel-note">ยังไม่มีห้องที่มีฐาน OPD พร้อมสำหรับประเมินเป้าหมายรายห้อง</p><% } %>
        </section>

        <section class="executive-decision-grid" aria-label="แนวโน้มและห้องที่ควรติดตาม">
          <article class="panel executive-trend-panel">
            <div class="panel-heading">
              <div>
                <h2>แนวโน้มบริการ Telemedicine <%= filters.granularity === 'month' ? 'รายเดือน' : (filters.granularity === 'week' ? 'รายสัปดาห์' : 'รายวัน') %></h2>
                <p class="panel-note">แท่งสีเขียวอมฟ้าแสดงจำนวนบริการ และป้าย “สูงสุด” ระบุช่วงที่มีบริการมากที่สุด</p>
                <p class="panel-note executive-trend-meta">รวม <%= metrics.total.toLocaleString('th-TH') %> ครั้ง · ให้บริการ <%= metrics.activeServiceDays.toLocaleString('th-TH') %> วัน · เฉลี่ย <%= metrics.averagePerDay.toLocaleString('th-TH', { maximumFractionDigits: 1 }) %> ครั้งต่อวันให้บริการ</p>
              </div>
              <span>ทั้งโรงพยาบาล · <%= filters.granularity === 'month' ? 'รายเดือน' : (filters.granularity === 'week' ? 'รายสัปดาห์' : 'รายวัน') %></span>
            </div>
            <div class="executive-chart-wrap">
              <canvas id="execTrendChart"></canvas>
              <% if (metrics.total === 0) { %><div class="executive-chart-empty">ไม่พบข้อมูลในช่วงวันที่เลือก</div><% } %>
            </div>
          </article>
          <section class="panel executive-followup-panel" aria-label="จุดที่ควรติดตาม">
            <div class="panel-heading executive-followup-heading">
              <div>
                <p class="eyebrow">จุดที่ควรติดตาม</p>
                <h2>5 ห้องที่ควรเร่งติดตาม</h2>
                <p class="panel-note">เรียงจากจำนวนครั้งที่ยังขาดจากเป้าหมายมากที่สุด</p>
              </div>
              <a class="secondary-button compact" href="/executive?tab=department-target&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>">
                <span>ดูทุกห้อง</span><i class="bi bi-arrow-right"></i>
              </a>
            </div>
            <% if (performance.followUp.length > 0) { %>
              <ol class="executive-followup-list">
                <% performance.followUp.forEach((row, index) => { const roomProgressRaw = Number(row.target_50 || 0) > 0 ? (Number(row.telemed_total || 0) / Number(row.target_50 || 0)) * 100 : 0; const roomProgress = Math.min(Math.max(roomProgressRaw, 0), 100); %>
                  <li>
                    <span class="rank"><%= index + 1 %></span>
                    <span class="executive-followup-content">
                      <span class="executive-followup-primary"><button type="button" class="executive-followup-room" data-target-detail="<%= row.depcode %>" data-room-label="<%= row.department %>"><%= row.department %></button><strong>ยังขาด <%= Math.abs(Number(row.diff_from_target || 0)).toLocaleString('th-TH') %> ครั้ง</strong></span>
                      <span class="executive-followup-secondary">ทำได้ <strong><%= Number(row.telemed_total || 0).toLocaleString('th-TH') %></strong> / เป้าหมาย <strong><%= Number(row.target_50 || 0).toLocaleString('th-TH') %></strong> ครั้ง <span><%= roomProgressRaw.toFixed(1) %>%</span></span>
                      <span class="executive-mini-progress" role="progressbar" aria-label="<%= row.department %> ทำได้ <%= roomProgressRaw.toFixed(1) %> เปอร์เซ็นต์ของเป้าหมาย" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= roomProgress.toFixed(1) %>"><span style="width: <%= roomProgress.toFixed(2) %>%"></span></span>
                    </span>
                  </li>
                <% }) %>
              </ol>
            <% } else { %>
              <div class="executive-inline-empty"><%= performance.available ? 'ทุกห้องที่ประเมินได้ถึงเป้าหมายแล้ว' : 'ยังไม่มีห้องที่สามารถประเมินเป้าหมายได้' %></div>
            <% } %>
          </section>
        </section>

        <article class="panel executive-summary-card">
          <h2>สรุปเพื่อการตัดสินใจ</h2>
          <div class="executive-summary-lines">
            <% if (performance.available) { %>
              <p>ห้องที่ประเมินทำได้ <strong><%= targetProgressRaw.toFixed(1) %>% ของเป้าหมาย</strong> และ<strong><%= performance.shortage > 0 ? `ยังขาด ${performance.shortage.toLocaleString('th-TH')} ครั้ง` : 'ถึงเป้าหมายแล้ว' %></strong></p>
              <p><% if (performance.followUp.length > 0) { %>ควรเร่งติดตาม <strong><%= performance.followUp.slice(0, 2).map((row) => row.department).join(', ') %></strong><% } else { %>ทุกห้องที่ประเมินได้ถึงเป้าหมายแล้ว<% } %></p>
            <% } else { %><p>ยังไม่มีห้องที่มีข้อมูลพร้อมประเมินเป้าหมายรายห้องในช่วงวันที่เลือก</p><% } %>
          </div>
        </article>

        <details class="panel executive-support-details" data-executive-details>
          <summary aria-expanded="false">ข้อมูลเพิ่มเติม</summary>
          <p class="panel-note executive-support-note">ข้อมูลส่วนนี้ใช้ประกอบการวิเคราะห์ ไม่ใช่ KPI หลักของผู้บริหาร</p>
          <section class="executive-secondary-strip" aria-label="ข้อมูลประกอบ">
            <div><span>เฉลี่ยต่อวันให้บริการ</span><strong><%= metrics.averagePerDay.toLocaleString('th-TH', { maximumFractionDigits: 1 }) %> ครั้ง</strong></div>
            <div><span>เบาหวาน</span><strong><%= metrics.dm.toLocaleString('th-TH') %> ครั้ง</strong></div>
            <div><span>ความดัน</span><strong><%= metrics.ht.toLocaleString('th-TH') %> ครั้ง</strong></div>
            <div><span>บริการแบบ B2C</span><strong><%= metrics.b2c.toLocaleString('th-TH') %> ครั้ง<% if (metrics.channelDataComplete) { %> · <%= metrics.b2cPercent.toFixed(1) %>%<% } %></strong></div>
            <div><span>วันให้บริการสูงสุด</span><strong><%= metrics.highestDay ? `${metrics.highestDay.total.toLocaleString('th-TH')} ครั้ง` : 'ไม่มีข้อมูล' %></strong><small><%= metrics.highestDay ? metrics.highestDay.dateSummary : '' %></small></div>
            <div><span>วันให้บริการต่ำสุด</span><strong><%= metrics.lowestDay ? `${metrics.lowestDay.total.toLocaleString('th-TH')} ครั้ง` : 'ไม่มีข้อมูล' %></strong><small><%= metrics.lowestDay ? metrics.lowestDay.dateSummary : '' %></small></div>
            <div><span>ส่งต่อแบบ B2B</span><strong><%= metrics.b2b.toLocaleString('th-TH') %> ครั้ง</strong></div>
            <div class="quality <%= metrics.qualitySummary.status %>"><span>คุณภาพข้อมูล</span><strong><%= metrics.qualitySummary.label %></strong></div>
          </section>
          <div class="executive-support-grid">
            <div><span>DM / HT ซ้อนกัน</span><strong><%= metrics.dmAndHt.toLocaleString('th-TH') %> ครั้ง</strong></div>
            <div><span>ช่องทางที่จำแนกได้</span><strong><%= metrics.channelCoverageRate.toFixed(1) %>%</strong></div>
            <div><span>Top 5 ห้องหลัก</span><strong><%= metrics.topFiveTelemedTotal.toLocaleString('th-TH') %> ครั้ง</strong></div>
            <div><span>ห้องหลักอื่น ๆ</span><strong><%= metrics.otherTelemedTotal.toLocaleString('th-TH') %> ครั้ง</strong></div>
            <div><span>ไม่ระบุห้องหลัก</span><strong><%= metrics.roomUnclassifiedTotal.toLocaleString('th-TH') %> ครั้ง</strong></div>
          </div>
          <% if (metrics.topRooms.length > 0) { %>
            <ol class="executive-support-room-list">
              <% metrics.topRooms.forEach((row, index) => { %><li><span><%= index + 1 %>. <%= row.department %></span><strong><%= Number(row.telemed_total || 0).toLocaleString('th-TH') %> ครั้ง</strong></li><% }) %>
            </ol>
          <% } %>
          <p class="panel-note">Top 5 + ห้องหลักอื่น ๆ + ไม่ระบุห้องหลัก = ครั้งรับบริการ Telemedicine ทั้งหมด</p>
        </details>

        <section class="panel executive-quality-summary <%= metrics.qualitySummary.status %>" aria-label="สถานะคุณภาพข้อมูล">
          <strong class="executive-quality-title">คุณภาพข้อมูล</strong>
          <span class="executive-quality-status <%= metrics.qualitySummary.status === 'ok' ? 'ok' : 'review' %>">
            <i class="bi <%= metrics.qualitySummary.status === 'ok' ? 'bi-check-circle' : 'bi-exclamation-triangle' %>"></i>
            <%= metrics.qualitySummary.issueCount > 0 ? `พบรายการที่ควรตรวจสอบ ${metrics.qualitySummary.issueCount.toLocaleString('th-TH')} รายการ` : 'ข้อมูลครบถ้วน' %>
          </span>
          <small><%= metrics.qualitySummary.issueCount > 0 ? metrics.qualitySummary.categories.join(' · ') : 'ไม่พบประเด็นจากการตรวจสอบยอดรวมที่ใช้ในหน้านี้' %></small>
          <% if (metrics.qualitySummary.issueCount > 0) { %><small class="executive-quality-impact">ผลต่อ KPI: <%= metrics.qualitySummary.impacts.join(' · ') %></small><% } %>
          <small>แสดงเฉพาะสถานะสรุป และไม่แสดงข้อมูลรายบุคคล</small>
          <% if (currentUser && currentUser.role === 'admin') { %><a href="/admin/data-quality?startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>">ดูรายละเอียดคุณภาพข้อมูล</a><% } %>
        </section>
        <% } %>
      </section>

      <section class="tab-panel <%= activeTab === 'department-target' ? 'active' : '' %>" data-exec-panel="department-target">
        <%
          const departmentTargetDefaultPercent = Number(target.targetPercent ?? 0);
          const departmentTargetLabel = target.summary.uses_mixed_targets
            ? 'เป้าหมายตามค่าที่กำหนดของแต่ละห้อง'
            : `เป้าหมาย ${Number(target.summary.target_percent ?? departmentTargetDefaultPercent).toLocaleString('th-TH', { maximumFractionDigits: 2 })}%`;
          const departmentTargetNearThreshold = (row) => Math.max(Number(row.target_percent || departmentTargetDefaultPercent) - 5, 0);
          const departmentTargetServiceGroups = [...new Set(target.departments.map((department) => department.service_group).filter(Boolean))];
        %>
        <section class="filter-panel">
          <% if (dbError || targetError) { %>
            <div class="alert db-alert"><strong><%= targetError || dbError %></strong></div>
          <% } %>
          <div class="panel-note target-intro">ติดตามผล Telemedicine รายห้อง เทียบ<%= departmentTargetLabel %>ของ OPD ในช่วงวันที่เลือก</div>
          <% if (currentUser && currentUser.role === 'admin' && target.rows.length > 0 && !target.hasB2b) { %>
            <details class="target-admin-details">
              <summary>รายละเอียดสำหรับผู้ดูแลระบบ</summary>
              <p>ยังไม่พบข้อมูล B2B ในช่วงวันที่เลือก ระบบตรวจสอบจาก ovstist.name หรือ opdscreen.cc</p>
            </details>
          <% } %>
          <form action="/executive" method="get" class="filter-grid department-target-filter">
            <input type="hidden" name="tab" value="department-target">
            <input type="hidden" name="serviceGroup" value="<%= targetFilters.serviceGroup %>" data-service-group-input>
            <label>
              วันที่เริ่มต้น
              <span class="thai-date-control">
                <span data-thai-date-display><%= metrics.startDateLabel %></span>
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                <input type="date" name="startDate" value="<%= filters.startDate %>" aria-label="วันที่เริ่มต้น <%= metrics.startDateLabel %>" data-thai-date-input>
              </span>
            </label>
            <label>
              วันที่สิ้นสุด
              <span class="thai-date-control">
                <span data-thai-date-display><%= metrics.endDateLabel %></span>
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                <input type="date" name="endDate" value="<%= filters.endDate %>" aria-label="วันที่สิ้นสุด <%= metrics.endDateLabel %>" data-thai-date-input>
              </span>
            </label>
            <label>
              เลือกห้องส่งตรวจ
              <select name="depcode">
                <option value="all" <%= targetFilters.depcode === 'all' ? 'selected' : '' %>>ทั้งหมด</option>
                <% target.departments.forEach((department) => { %>
                  <option value="<%= department.depcode %>" <%= targetFilters.depcode === department.depcode ? 'selected' : '' %>><%= department.department %> (<%= department.service_group %>)</option>
                <% }) %>
              </select>
            </label>
            <label>
              สถานะ
              <select name="status">
                <option value="all" <%= targetFilters.status === 'all' ? 'selected' : '' %>>ทั้งหมด</option>
                <option value="passed" <%= targetFilters.status === 'passed' ? 'selected' : '' %>>ผ่าน</option>
                <option value="near" <%= targetFilters.status === 'near' ? 'selected' : '' %>>ใกล้ถึงเป้า</option>
                <option value="failed" <%= targetFilters.status === 'failed' ? 'selected' : '' %>>ไม่ผ่าน</option>
                <option value="data_check" <%= targetFilters.status === 'data_check' ? 'selected' : '' %>>ตรวจสอบข้อมูล</option>
                <option value="no_data" <%= targetFilters.status === 'no_data' ? 'selected' : '' %>>ไม่มีข้อมูล</option>
              </select>
            </label>
            <label>
              การเรียงลำดับ
              <select name="sortBy">
                <option value="target_gap" <%= targetFilters.sortBy === 'target_gap' ? 'selected' : '' %>>ขาดเป้าหมายมากสุด</option>
                <option value="percent_low" <%= targetFilters.sortBy === 'percent_low' ? 'selected' : '' %>>% ต่ำสุด</option>
                <option value="telemed_desc" <%= targetFilters.sortBy === 'telemed_desc' ? 'selected' : '' %>>จำนวน Telemed ที่ทำได้มากสุด</option>
                <option value="opd_desc" <%= targetFilters.sortBy === 'opd_desc' ? 'selected' : '' %>>OPD มากสุด</option>
                <option value="name_asc" <%= targetFilters.sortBy === 'name_asc' ? 'selected' : '' %>>ชื่อห้อง A–Z</option>
              </select>
            </label>
            <label class="target-room-filter">
              ค้นหาชื่อห้อง
              <span class="input-with-icon"><i class="bi bi-search" aria-hidden="true"></i><input type="search" placeholder="พิมพ์ชื่อห้องบริการ" data-target-room-search></span>
            </label>
            <div class="service-group-filter">
              <span>กลุ่มบริการ</span>
              <div class="service-group-buttons" role="group" aria-label="เลือกกลุ่มบริการ">
                <% [{ value: 'all', label: 'ทั้งหมด' }, ...departmentTargetServiceGroups.map((group) => ({ value: group, label: group }))].forEach((group) => { %>
                  <button type="button" data-service-group="<%= group.value %>" class="service-group-button <%= targetFilters.serviceGroup === group.value ? 'active' : '' %>"><%= group.label %></button>
                <% }) %>
              </div>
            </div>
            <div class="filter-actions">
              <button type="submit" class="primary-button"><i class="bi bi-funnel"></i> แสดงผล</button>
              <a class="secondary-button" href="/executive/department-target.xlsx?startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>&depcode=<%= targetFilters.depcode %>&serviceGroup=<%= encodeURIComponent(targetFilters.serviceGroup) %>&status=<%= targetFilters.status %>&sortBy=<%= targetFilters.sortBy %>">
                <i class="bi bi-file-earmark-excel"></i>
                Export Excel
              </a>
            </div>
          </form>
        </section>

        <%
          const targetGap = Number(target.summary.diff_from_target || 0);
          const isAdminUser = Boolean(currentUser && currentUser.role === 'admin');
          const targetTableColumnCount = 15;
          const targetGapAbs = Math.abs(targetGap);
          const topFailedDepartments = target.summary.top_failed_departments || [];
          const validDepartments = target.rows.filter((row) => !row.is_data_anomaly && !row.is_no_data);
          const failedDepartments = validDepartments.filter((row) => row.diff_from_target < 0);
          const dataQualityRows = target.dataQualityRows || target.rows.filter((row) => row.is_data_anomaly);
          const noDataRows = target.noDataRows || target.rows.filter((row) => row.is_no_data);
          const dataStateRows = [...dataQualityRows, ...noDataRows];
          const topFollowUpRows = failedDepartments.slice(0, 5);
          const maximumFollowUpGap = topFollowUpRows.reduce(
            (maximum, row) => Math.max(maximum, Math.abs(Number(row.diff_from_target || 0))),
            0
          );
          const targetGoalProgressRaw = Number(target.summary.target_50_total || 0) > 0
            ? (Number(target.summary.telemed_total || 0) / Number(target.summary.target_50_total || 0)) * 100
            : 0;
          const targetGoalProgress = Math.min(Math.max(targetGoalProgressRaw, 0), 100);
          const targetPercentGap = target.summary.uses_mixed_targets
            ? Math.max(0, 100 - targetGoalProgressRaw)
            : Math.max(0, Number(target.summary.target_percent ?? departmentTargetDefaultPercent) - Number(target.summary.telemed_percent || 0));
          const targetDiffLabel = (value) => {
            const diff = Number(value || 0);
            if (diff < 0) return `ต้องเพิ่ม ${Math.abs(diff).toLocaleString('th-TH')} ครั้ง`;
            if (diff > 0) return `เกินเป้า ${diff.toLocaleString('th-TH')} ครั้ง`;
            return 'ถึงเป้า';
          };
          const targetStatusLabel = (row) => row.display_status || (row.telemed_total >= row.target_50 ? 'ผ่าน' : (row.telemed_percent >= departmentTargetNearThreshold(row) ? 'ใกล้ถึงเป้า' : 'ไม่ผ่าน'));
          const targetStatusClass = (row) => {
            if (row.is_no_data) return 'no-data';
            if (row.is_data_anomaly) return 'data-check';
            if (row.telemed_total >= row.target_50) return 'passed';
            if (row.telemed_percent >= departmentTargetNearThreshold(row)) return 'near';
            return 'failed';
          };
          const nearDepartments = validDepartments.filter((row) => targetStatusClass(row) === 'near');
          const urgentDepartment = failedDepartments.slice().sort((a, b) => Number(a.diff_from_target || 0) - Number(b.diff_from_target || 0))[0];
          const targetQuickRecommendation = dataQualityRows.length > 0
            ? `ควรตรวจสอบข้อมูล ${dataQualityRows.length.toLocaleString('th-TH')} รายการก่อนใช้ประเมินเป้าหมาย`
            : urgentDepartment
              ? `ควรติดตาม ${urgentDepartment.department} เป็นลำดับแรก เนื่องจากยังต้องเพิ่ม ${Math.abs(Number(urgentDepartment.diff_from_target || 0)).toLocaleString('th-TH')} ครั้ง`
              : nearDepartments.length > 0
              ? `${nearDepartments[0].department} ใกล้ถึงเป้าหมายแล้ว ควรติดตามต่อเนื่องเพื่อให้ผ่านเป้า`
                : validDepartments.length > 0
                  ? 'ทุกห้องที่ประเมินได้ถึงเป้าหมายแล้ว ควรรักษาแนวทางการให้บริการปัจจุบัน'
                  : noDataRows.length > 0
                    ? `${noDataRows.length.toLocaleString('th-TH')} ห้องไม่มีข้อมูล OPD และ Telemed ในช่วงวันที่เลือก`
                    : 'ไม่พบข้อมูลในช่วงวันที่เลือก';
          const targetChipCounts = {
            all: target.rows.length,
            passed: target.rows.filter((row) => targetStatusClass(row) === 'passed').length,
            near: target.rows.filter((row) => targetStatusClass(row) === 'near').length,
            failed: target.rows.filter((row) => targetStatusClass(row) === 'failed').length,
            data_check: target.rows.filter((row) => targetStatusClass(row) === 'data-check').length,
            no_data: target.rows.filter((row) => targetStatusClass(row) === 'no-data').length
          };
        %>

        <section class="panel action-required-panel">
          <div class="action-insight-main">
            <p class="eyebrow">ต้องดำเนินการ</p>
            <h2 class="action-insight-value">
              <% if (validDepartments.length > 0) { %>
                Telemed ต่อ OPD <strong><%= target.summary.telemed_percent.toFixed(2) %>%</strong>
              <% } else { %>
                <%= dataQualityRows.length > 0 ? 'ควรตรวจสอบข้อมูลก่อนประเมิน' : 'ยังไม่มีข้อมูลสำหรับประเมิน' %>
              <% } %>
            </h2>
            <% if (validDepartments.length > 0) { %>
              <p class="action-insight-context">
                <% if (targetPercentGap > 0) { %>
                  ยังต่ำกว่าเป้าหมาย <strong><%= targetPercentGap.toFixed(2) %> จุด</strong>
                <% } else { %>
                  ถึงหรือสูงกว่า<%= departmentTargetLabel %>แล้ว
                <% } %>
              </p>
            <% } %>
          </div>
          <p class="action-recommendation"><i class="bi bi-lightbulb" aria-hidden="true"></i><span>ข้อเสนอแนะ:</span> <%= targetQuickRecommendation %></p>
        </section>

        <section id="departmentTargetKpis" class="target-metric-overview">
          <div class="target-primary-metrics">
            <article class="target-primary-metric opd">
              <span class="target-metric-icon"><i class="bi bi-hospital" aria-hidden="true"></i></span>
              <div>
                <p>OPD รวม</p>
                <div class="target-metric-value"><strong><%= target.summary.opd_total.toLocaleString('th-TH') %></strong><span>ครั้ง</span></div>
              </div>
            </article>
            <article class="target-primary-metric telemed">
              <span class="target-metric-icon"><i class="bi bi-camera-video" aria-hidden="true"></i></span>
              <div>
                <p>จำนวน Telemed ที่ทำได้</p>
                <div class="target-metric-value"><strong><%= target.summary.telemed_total.toLocaleString('th-TH') %></strong><span>ครั้ง</span></div>
              </div>
            </article>
            <article class="target-primary-metric target">
              <span class="target-metric-icon"><i class="bi bi-bullseye" aria-hidden="true"></i></span>
              <div>
                <p><%= departmentTargetLabel %> <i class="bi bi-info-circle metric-info" tabindex="0" role="img" aria-label="เป้าหมายรวมเป็นผลรวมเป้าหมายที่ปัดขึ้นของแต่ละห้อง จึงอาจต่างจากการคำนวณจาก OPD รวม" title="เป้าหมายรวมเป็นผลรวมเป้าหมายที่ปัดขึ้นของแต่ละห้อง จึงอาจต่างจากการคำนวณจาก OPD รวม"></i></p>
                <div class="target-metric-value"><strong><%= target.summary.target_50_total.toLocaleString('th-TH') %></strong><span>ครั้ง</span></div>
              </div>
            </article>
            <article class="target-primary-metric ratio">
              <span class="target-metric-icon"><i class="bi bi-percent" aria-hidden="true"></i></span>
              <div>
                <p>สัดส่วน Telemed ต่อ OPD <i class="bi bi-info-circle metric-info" tabindex="0" role="img" aria-label="สัดส่วนเท่ากับ จำนวน Telemed ที่ทำได้ หารด้วย OPD รวม คูณ 100" title="สัดส่วน = จำนวน Telemed ที่ทำได้ ÷ OPD รวม × 100"></i></p>
                <div class="target-metric-value"><strong><%= target.summary.telemed_percent.toFixed(2) %></strong><span>%</span></div>
              </div>
            </article>
          </div>

          <div class="target-executive-widgets">
            <article class="target-gap-widget <%= validDepartments.length === 0 ? 'no-data' : (targetGap < 0 ? 'behind' : 'passed') %> <%= failedDepartments.length > 0 ? 'target-kpi-action' : '' %>" <% if (failedDepartments.length > 0) { %>data-target-kpi-action="gap" role="button" tabindex="0" aria-label="ดูรายละเอียดขาดเป้าหมายรวม"<% } %>>
              <div class="target-widget-heading">
                <div>
                  <p class="target-widget-label"><i class="bi bi-graph-down-arrow" aria-hidden="true"></i> ขาดเป้าหมาย</p>
                  <div class="target-gap-value">
                    <strong><%= validDepartments.length === 0 ? 'ประเมินไม่ได้' : (targetGap < 0 ? targetGapAbs.toLocaleString('th-TH') : (targetGap > 0 ? `+${targetGap.toLocaleString('th-TH')}` : 'ถึงเป้าหมายแล้ว')) %></strong>
                    <% if (validDepartments.length > 0 && targetGap !== 0) { %><span>ครั้ง</span><% } %>
                  </div>
                </div>
                <i class="bi bi-info-circle metric-info" tabindex="0" role="img" aria-label="จำนวนครั้งที่ต้องเพิ่มเพื่อให้ถึงเป้าหมายตามค่าที่กำหนด" title="จำนวนครั้งที่ต้องเพิ่มเพื่อให้ถึงเป้าหมายตามค่าที่กำหนด"></i>
              </div>
              <p class="target-gap-context">ทำได้ <strong><%= target.summary.telemed_total.toLocaleString('th-TH') %></strong> จากเป้าหมาย <strong><%= target.summary.target_50_total.toLocaleString('th-TH') %></strong> ครั้ง</p>
              <div class="target-gap-progress" role="progressbar" aria-label="ความก้าวหน้าเทียบเป้าหมาย" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= targetGoalProgress.toFixed(2) %>">
                <span style="width: <%= targetGoalProgress.toFixed(2) %>%"></span>
              </div>
              <p class="target-gap-progress-label"><%= target.summary.target_50_total > 0 ? `ทำได้แล้ว ${targetGoalProgressRaw.toFixed(2)}% ของเป้าหมาย` : 'ยังไม่มีเป้าหมายสำหรับประเมิน' %></p>
            </article>

            <article class="target-status-widget">
              <div class="target-widget-heading">
                <div>
                  <p class="target-widget-label"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i> สถานะห้องบริการ</p>
                  <p class="target-widget-note">เลือกสถานะเพื่อดูรายการในตาราง</p>
                </div>
              </div>
              <div class="target-status-widget-list">
                <button type="button" class="target-status-widget-row passed" <% if (target.summary.passed_department_count > 0) { %>data-target-kpi-action="passed"<% } else { %>disabled<% } %>>
                  <span><i class="bi bi-check-circle-fill" aria-hidden="true"></i> ผ่านเป้า</span>
                  <strong><%= target.summary.passed_department_count.toLocaleString('th-TH') %> ห้อง</strong>
                </button>
                <button type="button" class="target-status-widget-row near" <% if (nearDepartments.length > 0) { %>data-target-kpi-action="near"<% } else { %>disabled<% } %>>
                  <span><i class="bi bi-circle-half" aria-hidden="true"></i> ใกล้ถึงเป้า</span>
                  <strong><%= nearDepartments.length.toLocaleString('th-TH') %> ห้อง</strong>
                </button>
                <button type="button" class="target-status-widget-row failed" <% if (target.summary.failed_department_count > 0) { %>data-target-kpi-action="failed"<% } else { %>disabled<% } %>>
                  <span><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i> ยังไม่ผ่าน</span>
                  <strong><%= target.summary.failed_department_count.toLocaleString('th-TH') %> ห้อง</strong>
                </button>
                <button type="button" class="target-status-widget-row data-check" <% if (target.summary.data_check_count > 0) { %>data-target-kpi-action="data_check"<% } else { %>disabled<% } %>>
                  <span><i class="bi bi-search" aria-hidden="true"></i> ควรตรวจสอบ</span>
                  <strong><%= target.summary.data_check_count.toLocaleString('th-TH') %> รายการ</strong>
                </button>
              </div>
            </article>
          </div>
        </section>

        <section class="target-followup-grid">
        <section class="panel urgent-followup-panel">
          <div class="panel-heading followup-widget-heading">
            <div>
              <h2>ต้องติดตามวันนี้</h2>
              <p class="panel-note">5 ห้องที่มีช่องว่างจากเป้าหมายสูงสุด</p>
            </div>
            <div class="followup-widget-actions">
              <span class="followup-room-count"><%= topFollowUpRows.length.toLocaleString('th-TH') %> ห้อง</span>
              <button type="button" class="followup-view-all" data-target-view-all>
                ดูทั้งหมด <i class="bi bi-arrow-down" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          <div class="followup-compact-list">
            <% topFollowUpRows.forEach((row, index) => {
              const roomGap = Math.abs(Number(row.diff_from_target || 0));
              const miniGapWidth = maximumFollowUpGap > 0 ? (roomGap / maximumFollowUpGap) * 100 : 0;
            %>
              <div class="followup-compact-item">
                <span class="followup-rank"><%= index + 1 %></span>
                <div class="followup-room-summary">
                  <button type="button" class="followup-department-button" data-target-detail="<%= row.depcode %>" aria-haspopup="dialog" title="<%= row.department %>"><%= row.department %></button>
                  <span class="followup-mini-track" aria-hidden="true"><span style="width: <%= miniGapWidth.toFixed(2) %>%"></span></span>
                </div>
                <span class="followup-gap">ขาด <%= roomGap.toLocaleString('th-TH') %> ครั้ง</span>
                <span class="followup-priority <%= row.risk ? row.risk.className : 'watch' %>"><%= row.risk ? row.risk.label : 'ควรติดตาม' %></span>
              </div>
            <% }) %>
            <% if (failedDepartments.length === 0) { %>
              <p class="panel-note">ไม่มีห้องที่ขาดเป้าหมายในช่วงวันที่นี้</p>
            <% } %>
          </div>
        </section>
          <section class="panel near-target-panel <%= nearDepartments.length === 0 ? 'empty' : '' %>">
