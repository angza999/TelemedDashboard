<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Telemed Dashboard</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'executive' }) %>

    <main class="main executive-main">
      <header class="topbar">
        <div>
          <p class="eyebrow">ภาพรวมสำหรับผู้บริหาร</p>
          <h1>Executive Dashboard</h1>
        </div>
        <% if (currentUser) { %>
          <form action="/logout" method="post" class="user-box">
            <span><i class="bi bi-person-circle"></i> <%= currentUser.name %></span>
            <button type="submit" class="icon-button" title="ออกจากระบบ" aria-label="ออกจากระบบ">
              <i class="bi bi-box-arrow-right"></i>
            </button>
          </form>
        <% } %>
      </header>

      <div class="executive-tabs" role="tablist" aria-label="Executive Dashboard tabs">
        <button type="button" class="tab-button <%= activeTab === 'overview' ? 'active' : '' %>" data-exec-tab="overview">ภาพรวมผู้บริหาร</button>
        <button type="button" class="tab-button <%= activeTab === 'department-target' ? 'active' : '' %>" data-exec-tab="department-target">เป้าหมายรายห้อง</button>
      </div>

      <section class="tab-panel <%= activeTab === 'overview' ? 'active' : '' %>" data-exec-panel="overview">
        <section class="filter-panel executive-filter-panel">
          <% if (dbError) { %>
            <div class="alert db-alert"><strong><%= dbError %></strong></div>
          <% } %>
          <form action="/executive" method="get" class="filter-grid executive-filter">
            <input type="hidden" name="tab" value="overview">
            <label>
              วันที่เริ่มต้น
              <input type="date" name="startDate" value="<%= filters.startDate %>">
            </label>
            <label>
              วันที่สิ้นสุด
              <input type="date" name="endDate" value="<%= filters.endDate %>">
            </label>
            <label>
              แนวโน้ม
              <select name="granularity">
                <option value="day" <%= filters.granularity === 'day' ? 'selected' : '' %>>รายวัน</option>
                <option value="month" <%= filters.granularity === 'month' ? 'selected' : '' %>>รายเดือน</option>
              </select>
            </label>
            <div class="filter-actions">
              <button type="submit" class="primary-button" data-executive-submit><i class="bi bi-funnel"></i> <span>แสดงผล</span></button>
              <a class="secondary-button" data-executive-pdf href="/executive/export.pdf?startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>&granularity=<%= filters.granularity %>">
                <i class="bi bi-filetype-pdf"></i>
                <span>Export PDF</span>
              </a>
            </div>
          </form>
          <p class="executive-export-status" data-executive-status role="status" aria-live="polite"></p>
        </section>

        <section class="executive-hero-kpis" aria-label="ตัวชี้วัดสำคัญ">
          <article class="executive-hero-kpi primary">
            <div class="executive-kpi-heading">
              <span class="executive-kpi-icon"><i class="bi bi-camera-video"></i></span>
              <p>ผู้รับบริการ Telemed ทั้งหมด</p>
            </div>
            <div class="executive-kpi-value"><strong><%= metrics.total.toLocaleString('th-TH') %></strong><span>ครั้ง</span></div>
            <div
              class="executive-comparison-badge <%= metrics.previousChangePercent === null ? 'neutral' : (metrics.previousChangePercent >= 0 ? 'up' : 'down') %>"
              title="เทียบกับช่วงวันที่ <%= metrics.previousFilters.startDate %> ถึง <%= metrics.previousFilters.endDate %> ซึ่งมีจำนวนวันเท่ากัน"
            >
              <i class="bi <%= metrics.previousChangePercent === null ? 'bi-dash' : (metrics.previousChangePercent >= 0 ? 'bi-arrow-up-right' : 'bi-arrow-down-right') %>"></i>
              <% if (metrics.previousChangePercent === null) { %>
                ช่วงก่อนหน้า <%= metrics.previousTotal.toLocaleString('th-TH') %> ครั้ง
              <% } else { %>
                <%= Math.abs(metrics.previousChangePercent).toFixed(1) %>% จากช่วงก่อนหน้า
              <% } %>
            </div>
            <small class="executive-comparison-note">เทียบช่วงก่อนหน้าในจำนวนวันเท่ากัน</small>
          </article>
          <article class="executive-hero-kpi">
            <div class="executive-kpi-heading">
              <span class="executive-kpi-icon blue"><i class="bi bi-calendar3"></i></span>
              <p>เฉลี่ยต่อวัน</p>
            </div>
            <div class="executive-kpi-value"><strong><%= metrics.averagePerDay.toLocaleString('th-TH', { maximumFractionDigits: 1 }) %></strong><span>ครั้ง/วัน</span></div>
            <small><%= metrics.periodDays.toLocaleString('th-TH') %> วันตามช่วงที่เลือก</small>
          </article>
          <article class="executive-hero-kpi">
            <div class="executive-kpi-heading">
              <span class="executive-kpi-icon amber"><i class="bi bi-graph-up-arrow"></i></span>
              <p>วันที่มีบริการสูงสุด</p>
            </div>
            <% if (metrics.highestDay) { %>
              <div class="executive-kpi-value"><strong><%= metrics.highestDay.total.toLocaleString('th-TH') %></strong><span>ครั้ง</span></div>
              <small><%= metrics.highestDay.date %></small>
            <% } else { %>
              <div class="executive-kpi-value"><strong>0</strong><span>ครั้ง</span></div>
              <small>ไม่พบข้อมูล</small>
            <% } %>
          </article>
          <article class="executive-hero-kpi">
            <div class="executive-kpi-heading">
              <span class="executive-kpi-icon rose"><i class="bi bi-graph-down-arrow"></i></span>
              <p>วันที่มีบริการต่ำสุด</p>
            </div>
            <% if (metrics.lowestDay) { %>
              <div class="executive-kpi-value"><strong><%= metrics.lowestDay.total.toLocaleString('th-TH') %></strong><span>ครั้ง</span></div>
              <small class="executive-kpi-date">
                <span><%= metrics.lowestDay.date %></span>
                <% if (metrics.lowestDayMayBeIncomplete) { %>
                  <span class="executive-kpi-caution"><i class="bi bi-clock-history"></i> ข้อมูลวันสุดท้ายอาจยังไม่ครบ</span>
                <% } %>
              </small>
            <% } else { %>
              <div class="executive-kpi-value"><strong>0</strong><span>ครั้ง</span></div>
              <small>ไม่พบข้อมูล</small>
            <% } %>
          </article>
        </section>

        <section class="executive-breakdown-grid" aria-label="สรุปกลุ่มโรคและรูปแบบบริการ">
          <article class="executive-breakdown-item">
            <span>
              <i class="bi bi-droplet-half"></i> เบาหวานรวม
              <% if (currentUser && currentUser.role === 'admin') { %>
                <button class="info-icon-button" type="button" title="จำนวน visit ที่พบรหัสโรค E11 ตามเงื่อนไข"><i class="bi bi-info-circle"></i></button>
              <% } %>
            </span>
            <strong><%= metrics.dm.toLocaleString('th-TH') %> <small>ครั้ง</small></strong>
            <div class="executive-mini-track"><span class="dm" style="width: <%= Math.min(metrics.dmPercent, 100).toFixed(1) %>%"></span></div>
            <small><%= metrics.dmPercent.toFixed(1) %>% ของ DM และ HT</small>
          </article>
          <article class="executive-breakdown-item">
            <span>
              <i class="bi bi-heart-pulse"></i> ความดันรวม
              <% if (currentUser && currentUser.role === 'admin') { %>
                <button class="info-icon-button" type="button" title="จำนวน visit ที่พบรหัสโรค I10 ตามเงื่อนไข"><i class="bi bi-info-circle"></i></button>
              <% } %>
            </span>
            <strong><%= metrics.ht.toLocaleString('th-TH') %> <small>ครั้ง</small></strong>
            <div class="executive-mini-track"><span class="ht" style="width: <%= Math.min(metrics.htPercent, 100).toFixed(1) %>%"></span></div>
            <small><%= metrics.htPercent.toFixed(1) %>% ของ DM และ HT</small>
          </article>
          <article class="executive-breakdown-item">
            <span><i class="bi bi-hospital"></i> ส่งต่อแบบ B2B</span>
            <strong><%= metrics.b2b.toLocaleString('th-TH') %> <small>ครั้ง</small></strong>
            <% if (metrics.b2b === 0) { %>
              <span class="executive-zero-badge"><i class="bi bi-info-circle"></i> ยังไม่พบรายการ B2B</span>
            <% } else { %>
              <small><%= metrics.b2bPercent.toFixed(1) %>% ของ B2B/B2C</small>
            <% } %>
          </article>
          <article class="executive-breakdown-item">
            <span><i class="bi bi-person-video3"></i> ให้บริการแบบ B2C</span>
            <strong><%= metrics.b2c.toLocaleString('th-TH') %> <small>ครั้ง</small></strong>
            <div class="executive-target-row">
              <small><%= metrics.b2cPercent.toFixed(1) %>%</small>
              <span
                class="<%= metrics.b2cTargetMet ? 'met' : 'behind' %>"
                title="เป้าหมาย B2C ขั้นต่ำ 50% ของบริการ Telemed"
                aria-label="เป้าหมาย B2C ขั้นต่ำ 50% ของบริการ Telemed"
              >เป้า <%= metrics.b2cTargetPercent.toFixed(0) %>%</span>
            </div>
          </article>
        </section>

        <section class="executive-priority-grid" aria-label="ห้องบริการอันดับสูงสุดและข้อสรุปสำหรับผู้บริหาร">
          <article class="panel executive-top-rooms">
            <div class="panel-heading">
              <div>
                <p class="eyebrow">ผลงานตามห้องบริการ</p>
                <h2>Top 5 ห้องบริการ Telemed</h2>
                <p class="panel-note">จัดอันดับห้องบริการตามจำนวนผู้รับบริการ Telemed ในช่วงวันที่เลือก</p>
              </div>
            </div>
            <% if (metrics.departments.topDepartments.length > 0) { %>
              <ol>
                <% metrics.departments.topDepartments.forEach((row, index) => { %>
                  <li>
                    <span class="rank"><%= index + 1 %></span>
                    <span class="room" title="<%= row.department %>"><%= row.department %></span>
                    <strong><%= Number(row.telemed_total || 0).toLocaleString('th-TH') %> ครั้ง</strong>
                  </li>
                <% }) %>
              </ol>
              <% if (metrics.otherTelemedTotal > 0) { %>
                <div class="executive-top-rooms-other">
                  <span><i class="bi bi-three-dots"></i> อื่น ๆ</span>
                  <strong><%= metrics.otherTelemedTotal.toLocaleString('th-TH') %> ครั้ง</strong>
                </div>
              <% } %>
              <p class="executive-top-rooms-coverage">
                Top 5 ครอบคลุม <%= metrics.topFiveTelemedTotal.toLocaleString('th-TH') %> จาก <%= metrics.total.toLocaleString('th-TH') %> ครั้ง
              </p>
            <% } else { %>
              <div class="executive-inline-empty">ไม่พบข้อมูลห้องบริการในช่วงวันที่เลือก</div>
            <% } %>
          </article>

          <article class="panel executive-insights">
            <div class="panel-heading">
              <div>
                <p class="eyebrow">สรุปสำหรับตัดสินใจ</p>
                <h2>Executive Insights</h2>
              </div>
              <span><%= filters.startDate %> ถึง <%= filters.endDate %></span>
            </div>
            <ul>
              <% metrics.insights.forEach((insight) => { %>
                <li><i class="bi bi-check2-circle"></i><span><%= insight %></span></li>
              <% }) %>
            </ul>
          </article>
        </section>

        <section class="executive-analytics-grid">
          <article class="panel executive-trend-panel">
            <div class="panel-heading">
              <div>
                <h2>แนวโน้มผู้รับบริการ Telemed</h2>
                <p class="panel-note">ยอดรวม พร้อมเส้นค่าเฉลี่ยและจุดสูงสุด</p>
              </div>
              <span><%= filters.granularity === 'month' ? 'รายเดือน' : 'รายวัน' %></span>
            </div>
            <div class="executive-chart-wrap">
              <canvas id="execTrendChart"></canvas>
              <% if (metrics.total === 0) { %><div class="executive-chart-empty">ไม่พบข้อมูลในช่วงวันที่เลือก</div><% } %>
            </div>
          </article>
          <article class="panel executive-channel-panel">
            <div class="panel-heading">
              <div>
                <h2>สัดส่วน B2B / B2C</h2>
                <p class="panel-note">รูปแบบการให้บริการ</p>
              </div>
            </div>
            <div class="executive-donut-wrap">
              <canvas id="execChannelChart"></canvas>
              <div class="executive-donut-center">
                <% if ((metrics.b2b + metrics.b2c) > 0) { %>
                  <strong><%= metrics.b2b === 0 ? 'B2C' : 'รวม' %> <%= metrics.b2b === 0 ? `${metrics.b2cPercent.toFixed(0)}%` : '' %></strong>
                  <span><%= (metrics.b2b + metrics.b2c).toLocaleString('th-TH') %> ครั้ง</span>
                <% } else { %>
                  <strong>ไม่มีข้อมูล</strong>
                  <span>B2B / B2C</span>
                <% } %>
              </div>
            </div>
            <% if (metrics.b2b === 0 && metrics.b2c > 0) { %><p class="executive-chart-note">B2B: 0 ครั้ง</p><% } %>
          </article>
          <article class="panel executive-disease-panel">
            <div class="panel-heading">
              <div>
                <h2>สัดส่วนกลุ่มโรค</h2>
                <p class="panel-note">DM และ HT อาจนับ visit เดียวกันได้</p>
              </div>
            </div>
            <div class="executive-disease-bars">
              <div>
                <span>เบาหวาน</span><strong><%= metrics.dm.toLocaleString('th-TH') %> ครั้ง</strong>
                <div class="executive-mini-track large"><span class="dm" style="width: <%= Math.min(metrics.dmPercent, 100).toFixed(1) %>%"></span></div>
                <small><%= metrics.dmPercent.toFixed(1) %>%</small>
              </div>
              <div>
                <span>ความดัน</span><strong><%= metrics.ht.toLocaleString('th-TH') %> ครั้ง</strong>
                <div class="executive-mini-track large"><span class="ht" style="width: <%= Math.min(metrics.htPercent, 100).toFixed(1) %>%"></span></div>
                <small><%= metrics.htPercent.toFixed(1) %>%</small>
              </div>
            </div>
          </article>
        </section>
      </section>

      <section class="tab-panel <%= activeTab === 'department-target' ? 'active' : '' %>" data-exec-panel="department-target">
        <section class="filter-panel">
          <% if (dbError || targetError) { %>
            <div class="alert db-alert"><strong><%= targetError || dbError %></strong></div>
          <% } %>
          <div class="panel-note target-intro">
            หน้านี้ใช้ติดตามจำนวน Telemed ของแต่ละห้องส่งตรวจ เทียบกับเป้าหมาย 50% ของจำนวนผู้รับบริการ OPD ในช่วงวันที่ที่เลือก
          </div>
          <% if (currentUser && currentUser.role === 'admin' && target.rows.length > 0 && !target.hasB2b) { %>
            <div class="data-quality-note">
              <i class="bi bi-info-circle"></i>
              <span>ข้อสังเกตข้อมูล: ยังไม่พบข้อมูล B2B ในช่วงวันที่เลือก กรุณาตรวจสอบการบันทึกคำว่า B2B ใน ovstist.name หรือ opdscreen.cc หากคาดว่าควรมีข้อมูล</span>
            </div>
          <% } %>
          <div class="target-method-note">
            <i class="bi bi-info-circle"></i>
            <span>OPD รวม นับจากจำนวน VN ของห้องส่งตรวจที่กำหนดไว้ ส่วนจำนวน Telemed ที่ทำได้ นับจาก visit ที่อยู่ในเงื่อนไข Telemed ตามระบบ และนำมาเทียบกับเป้าหมาย 50% ของ OPD รายห้อง</span>
          </div>
          <form action="/executive" method="get" class="filter-grid department-target-filter">
            <input type="hidden" name="tab" value="department-target">
            <input type="hidden" name="serviceGroup" value="<%= targetFilters.serviceGroup %>" data-service-group-input>
            <label>
              วันที่เริ่มต้น
              <input type="date" name="startDate" value="<%= filters.startDate %>">
            </label>
            <label>
              วันที่สิ้นสุด
              <input type="date" name="endDate" value="<%= filters.endDate %>">
            </label>
            <label>
              เลือกห้องส่งตรวจ
              <select name="depcode">
                <option value="all" <%= targetFilters.depcode === 'all' ? 'selected' : '' %>>ทั้งหมด</option>
                <% target.departments.forEach((department) => { %>
                  <option value="<%= department.depcode %>" <%= targetFilters.depcode === department.depcode ? 'selected' : '' %>><%= department.department %> (<%= department.service_group %>)</option>
                <% }) %>
              </select>
            </label>
            <label>
              สถานะ
              <select name="status">
                <option value="all" <%= targetFilters.status === 'all' ? 'selected' : '' %>>ทั้งหมด</option>
                <option value="passed" <%= targetFilters.status === 'passed' ? 'selected' : '' %>>ผ่านเป้าหมาย</option>
                <option value="failed" <%= targetFilters.status === 'failed' ? 'selected' : '' %>>ยังไม่ถึงเป้าหมาย</option>
              </select>
            </label>
            <label>
              การเรียงลำดับ
              <select name="sortBy">
                <option value="target_gap" <%= targetFilters.sortBy === 'target_gap' ? 'selected' : '' %>>ขาดเป้าหมายมากสุด</option>
                <option value="percent_low" <%= targetFilters.sortBy === 'percent_low' ? 'selected' : '' %>>% ต่ำสุด</option>
                <option value="telemed_desc" <%= targetFilters.sortBy === 'telemed_desc' ? 'selected' : '' %>>จำนวน Telemed ที่ทำได้มากสุด</option>
                <option value="opd_desc" <%= targetFilters.sortBy === 'opd_desc' ? 'selected' : '' %>>OPD มากสุด</option>
              </select>
            </label>
            <div class="service-group-filter">
              <span>กลุ่มบริการ</span>
              <div class="service-group-buttons" role="group" aria-label="เลือกกลุ่มบริการ">
                <% [
                  { value: 'all', label: 'ทั้งหมด' },
                  { value: 'Telemed', label: 'Telemed' },
                  { value: 'กายภาพ', label: 'กายภาพ' },
                  { value: 'อุบัติเหตุฉุกเฉิน', label: 'อุบัติเหตุฉุกเฉิน' },
                  { value: 'แผนไทย', label: 'แผนไทย' }
                ].forEach((group) => { %>
                  <button type="button" data-service-group="<%= group.value %>" class="service-group-button <%= targetFilters.serviceGroup === group.value ? 'active' : '' %>"><%= group.label %></button>
                <% }) %>
              </div>
            </div>
            <div class="filter-actions">
              <button type="submit" class="primary-button"><i class="bi bi-funnel"></i> แสดงผล</button>
              <a class="secondary-button" href="/executive/department-target.xlsx?startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>&depcode=<%= targetFilters.depcode %>&serviceGroup=<%= encodeURIComponent(targetFilters.serviceGroup) %>&status=<%= targetFilters.status %>&sortBy=<%= targetFilters.sortBy %>">
                <i class="bi bi-file-earmark-excel"></i>
                Export Excel
              </a>
            </div>
          </form>
        </section>

        <%
          const targetGap = Number(target.summary.diff_from_target || 0);
          const targetGapAbs = Math.abs(targetGap);
          const worstDepartment = target.summary.worst_department;
          const topFailedDepartments = target.summary.top_failed_departments || [];
          const failedDepartments = target.rows.filter((row) => row.diff_from_target < 0);
          const followUpRooms = topFailedDepartments.map((row) => row.department).join(', ');
          const followUpLabel = failedDepartments.length === 0
            ? 'ไม่มีห้องที่ต้องติดตามในช่วงวันที่นี้'
            : failedDepartments.length < 5
              ? `ห้องที่ต้องติดตาม ${failedDepartments.length.toLocaleString('th-TH')} ห้อง`
              : 'Top 5 ห้องที่ขาดเป้าหมายมากที่สุด';
          const targetGoalPercent = target.summary.target_50_total > 0
            ? (target.summary.telemed_total / target.summary.target_50_total) * 100
            : 0;
          const targetGoalProgress = Math.min(targetGoalPercent, 100);
          const targetPercentGap = Math.max(0, 50 - Number(target.summary.telemed_percent || 0));
          const topActionRooms = topFailedDepartments.slice(0, 3);
          const targetDiffLabel = (value) => {
            const diff = Number(value || 0);
            if (diff < 0) return `ต้องเพิ่ม ${Math.abs(diff).toLocaleString('th-TH')} ราย`;
            if (diff > 0) return `เกินเป้า ${diff.toLocaleString('th-TH')} ราย`;
            return 'ถึงเป้า';
          };
          const targetStatusLabel = (row) => {
            if (row.telemed_total >= row.target_50) return 'ผ่าน';
            if (row.telemed_percent >= 45) return 'ใกล้ถึง';
            return 'ไม่ผ่าน';
          };
          let targetExecutiveSummary = 'ไม่พบข้อมูลในช่วงวันที่ที่เลือก';
          if (target.rows.length > 0) {
            targetExecutiveSummary = `ช่วงวันที่ ${filters.startDate} - ${filters.endDate} มี OPD รวม ${target.summary.opd_total.toLocaleString('th-TH')} ราย มีจำนวน Telemed ที่ทำได้รวม ${target.summary.telemed_total.toLocaleString('th-TH')} ราย คิดเป็นสัดส่วน Telemed ต่อ OPD ${target.summary.telemed_percent.toFixed(2)}% เป้าหมาย 50% คือ ${target.summary.target_50_total.toLocaleString('th-TH')} ราย `;
            targetExecutiveSummary += targetGap < 0
              ? `ยังขาดเป้าหมาย ${targetGapAbs.toLocaleString('th-TH')} ราย`
              : 'ถึงเป้าหมายแล้ว';
            if (followUpRooms) {
              targetExecutiveSummary += ` ห้องที่ควรติดตามเร่งด่วน ได้แก่ ${followUpRooms}`;
            }
          }
        %>

        <section class="panel action-required-panel">
          <div>
            <p class="eyebrow">Action Required</p>
            <h2><%= targetGap < 0 ? `ยังขาดเป้าหมาย ${targetGapAbs.toLocaleString('th-TH')} ราย` : 'ถึงเป้าหมายรวมแล้ว' %></h2>
            <p>
              สัดส่วน Telemed ต่อ OPD <strong><%= target.summary.telemed_percent.toFixed(2) %>%</strong> จากเป้าหมาย 50%
              <% if (targetPercentGap > 0) { %>
                ยังต่ำกว่าเป้า <strong><%= targetPercentGap.toFixed(2) %> จุด</strong>
              <% } %>
            </p>
          </div>
          <div class="action-room-list">
            <% if (topActionRooms.length > 0) { %>
              <% topActionRooms.forEach((row) => { %>
                <span><%= row.department %> <strong>ขาด <%= Math.abs(row.diff_from_target).toLocaleString('th-TH') %> ราย</strong></span>
              <% }) %>
            <% } else { %>
              <span><strong>ไม่มีห้องที่ขาดเป้าหมาย</strong></span>
            <% } %>
          </div>
        </section>

        <section class="panel target-executive-summary">
          <div class="panel-heading">
            <h2>Executive Summary</h2>
          </div>
          <p><%= targetExecutiveSummary %></p>
        </section>

        <section class="panel target-overall-progress">
          <div class="panel-heading">
            <div>
              <h2>ความคืบหน้าสู่เป้าหมาย</h2>
              <p class="panel-note">จำนวน Telemed ที่ทำได้ <%= target.summary.telemed_total.toLocaleString('th-TH') %> / เป้าหมาย <%= target.summary.target_50_total.toLocaleString('th-TH') %> ราย</p>
            </div>
            <strong><%= targetGoalPercent.toFixed(2) %>%</strong>
          </div>
          <div class="overall-progress-track" aria-hidden="true">
            <span class="overall-progress-fill <%= targetGap < 0 ? 'behind' : 'passed' %>" style="width: <%= targetGoalProgress.toFixed(2) %>%"></span>
          </div>
          <div class="overall-progress-meta">
            <span>เริ่มต้น</span>
            <span>เป้าหมาย 100%</span>
          </div>
          <p class="target-count-note">คำนวณจากจำนวน Telemed ที่ทำได้ เทียบกับเป้าหมาย 50%</p>
        </section>

        <section class="executive-kpis target-kpis">
          <article class="executive-kpi">
            <p>ห้องบริการทั้งหมด</p>
            <strong><%= metrics.departments.filtered.roomCount.toLocaleString('th-TH') %></strong>
            <span>ห้อง</span>
          </article>
          <article class="executive-kpi"><p>OPD รวม</p><strong><%= target.summary.opd_total.toLocaleString('th-TH') %></strong></article>
          <article class="executive-kpi"><p>จำนวน Telemed ที่ทำได้</p><strong><%= target.summary.telemed_total.toLocaleString('th-TH') %></strong></article>
          <article class="executive-kpi"><p>เป้าหมาย 50%</p><strong><%= target.summary.target_50_total.toLocaleString('th-TH') %></strong></article>
          <article class="executive-kpi">
            <p>สัดส่วน Telemed ต่อ OPD</p>
            <strong><%= target.summary.telemed_percent.toFixed(2) %>%</strong>
            <span>เทียบ OPD ทั้งหมด</span>
          </article>
          <article class="executive-kpi primary target-gap-kpi <%= targetGap < 0 ? 'behind' : 'passed' %>">
            <p><%= targetGap < 0 ? 'ขาดเป้ารวม' : 'เกินเป้ารวม' %></p>
            <strong><%= targetGap < 0 ? `ขาด ${targetGapAbs.toLocaleString('th-TH')}` : (targetGap > 0 ? `+${targetGap.toLocaleString('th-TH')}` : 'ถึงเป้าหมายแล้ว') %></strong>
            <% if (targetGap !== 0) { %><span>ราย</span><% } %>
          </article>
          <article class="executive-kpi"><p>ผ่านเป้า</p><strong><%= target.summary.passed_department_count.toLocaleString('th-TH') %></strong></article>
          <article class="executive-kpi"><p>ยังไม่ผ่าน</p><strong><%= target.summary.failed_department_count.toLocaleString('th-TH') %></strong></article>
          <article class="executive-kpi">
            <p>ความสำเร็จรายห้อง</p>
            <strong><%= metrics.departments.filtered.successPercent.toFixed(1) %>%</strong>
            <span><%= metrics.departments.filtered.passedCount.toLocaleString('th-TH') %> จาก <%= metrics.departments.filtered.roomCount.toLocaleString('th-TH') %> ห้อง</span>
          </article>
          <article class="executive-kpi worst-gap-kpi">
            <p>ผลงานเด่น</p>
            <% if (metrics.departments.filtered.bestDepartment) { %>
              <strong><%= metrics.departments.filtered.bestDepartment.department %></strong>
              <span><%= Number(metrics.departments.filtered.bestDepartment.telemed_percent || 0).toFixed(1) %>% ของ OPD</span>
            <% } else { %>
              <strong>ไม่พบข้อมูล</strong>
            <% } %>
          </article>
          <article class="executive-kpi worst-gap-kpi">
            <p>ขาดมากที่สุด</p>
            <% if (worstDepartment) { %>
              <strong><%= worstDepartment.department %></strong>
              <span>ขาด <%= Math.abs(worstDepartment.diff_from_target).toLocaleString('th-TH') %> ราย</span>
            <% } else { %>
              <strong>ไม่มีห้องที่ขาดเป้า</strong>
            <% } %>
          </article>
        </section>

        <section class="panel urgent-followup-panel">
          <div class="panel-heading">
            <div>
              <h2>ต้องติดตามวันนี้</h2>
              <p class="panel-note"><%= followUpLabel %></p>
            </div>
          </div>
          <div class="shortage-list priority-list">
            <% target.rows.filter((row) => row.diff_from_target < 0).slice(0, 5).forEach((row, index) => { %>
              <div class="shortage-item priority-item">
                <span><strong><%= index + 1 %>.</strong> <%= row.department %></span>
                <strong>ขาด <%= Math.abs(row.diff_from_target).toLocaleString('th-TH') %> ราย</strong>
                <small>สัดส่วน Telemed ต่อ OPD <%= Number(row.telemed_percent || 0).toFixed(2) %>% | จำนวน Telemed ที่ทำได้ <%= row.telemed_total.toLocaleString('th-TH') %> ราย</small>
              </div>
            <% }) %>
            <% if (!target.rows.some((row) => row.diff_from_target < 0)) { %>
              <p class="panel-note">ไม่มีห้องที่ขาดเป้าหมายในช่วงวันที่นี้</p>
            <% } %>
          </div>
        </section>

        <section class="dashboard-grid executive-charts target-charts">
          <article class="panel wide">
            <div class="panel-heading">
              <h2>จำนวน Telemed ที่ทำได้เทียบเป้าหมายรายห้อง</h2>
              <div class="chart-limit-toggle" aria-label="เลือกจำนวนห้องในกราฟ">
                <button type="button" class="chart-limit-button active" data-target-chart-limit="10">Top 10</button>
                <button type="button" class="chart-limit-button" data-target-chart-limit="20">Top 20</button>
                <button type="button" class="chart-limit-button" data-target-chart-limit="all">ทั้งหมด</button>
              </div>
            </div>
            <div class="target-chart-canvas-wrap">
              <canvas id="departmentTargetChart"></canvas>
            </div>
          </article>
          <article class="panel wide">
            <div class="panel-heading">
              <h2>ขาดเป้าหมายรายห้อง</h2>
              <span>จำนวนรายที่ต้องเพิ่มเพื่อถึงเป้าหมาย 50%</span>
            </div>
            <div class="target-chart-canvas-wrap">
              <canvas id="departmentPercentChart"></canvas>
            </div>
          </article>
        </section>

        <section class="panel table-panel">
          <div class="panel-heading">
            <div>
              <h2>ติดตามเป้าหมาย Telemed รายห้อง</h2>
              <p class="panel-note">เรียงห้องที่ยังไม่ถึงเป้าหมายและขาดเป้าหมายมากที่สุดก่อน</p>
            </div>
            <div class="table-view-toggle target-table-toggle" aria-label="เลือกมุมมองตารางเป้าหมายรายห้อง">
              <button type="button" class="table-view-button active" data-target-table-view="summary">ผู้บริหาร</button>
              <button type="button" class="table-view-button" data-target-table-view="detail">รายละเอียด</button>
            </div>
          </div>
          <div class="target-status-legend" aria-label="คำอธิบายสถานะ">
            <span><i class="legend-dot passed"></i> ผ่าน = จำนวน Telemed ที่ทำได้ถึงเป้าหมาย 50%</span>
            <span><i class="legend-dot near"></i> ใกล้ถึง = ทำได้ 45-49.99%</span>
            <span><i class="legend-dot failed"></i> ไม่ผ่าน = ทำได้น้อยกว่า 45%</span>
          </div>
          <div class="table-wrap department-target-table-wrap">
            <table class="department-target-table summary-mode">
              <thead>
                <tr>
                  <th>ลำดับ</th>
                  <th class="target-detail-column">รหัสห้อง</th>
                  <th>ห้องส่งตรวจ</th>
                  <th>กลุ่มบริการ</th>
                  <th class="target-detail-column">OPD source</th>
                  <th class="target-detail-column">Telemed source</th>
                  <th>OPD ทั้งหมด</th>
                  <th>จำนวน Telemed ที่ทำได้</th>
                  <th class="target-detail-column">B2B</th>
                  <th class="target-detail-column">B2C</th>
                  <th class="target-detail-column">เป้าหมาย 50%</th>
                  <th>สัดส่วน Telemed ต่อ OPD</th>
                  <th>ต้องเพิ่ม/เกินเป้า</th>
                  <th>สถานะ</th>
                </tr>
              </thead>
              <tbody>
                <% if (target.rows.length === 0) { %>
                  <tr><td colspan="14" class="empty">ไม่พบข้อมูลในช่วงวันที่ที่เลือก</td></tr>
                <% } %>
                <% target.rows.forEach((row, index) => { %>
                  <tr class="<%= row.target_status === 'ยังไม่ถึงเป้าหมาย' ? 'target-row-failed' : '' %>">
                    <td><%= index + 1 %></td>
                    <td class="target-detail-column"><%= row.depcode %></td>
                    <td>
                      <div class="target-department-name">
                        <span><%= row.department %></span>
                        <% if (row.calculation_note) { %>
                          <small class="target-row-note" title="<%= row.calculation_note %>"><i class="bi bi-info-circle"></i> ดูสูตรนับ</small>
                        <% } %>
                      </div>
                    </td>
                    <td><%= row.service_group %></td>
                    <td class="target-detail-column"><%= row.opd_source_deps.join(', ') %></td>
                    <td class="target-detail-column"><%= row.telemed_count_deps.join(', ') %></td>
                    <td><%= row.opd_total.toLocaleString('th-TH') %></td>
                    <td><%= row.telemed_total.toLocaleString('th-TH') %></td>
                    <td class="target-detail-column"><%= row.b2b_total.toLocaleString('th-TH') %></td>
                    <td class="target-detail-column"><%= row.b2c_total.toLocaleString('th-TH') %></td>
                    <td class="target-detail-column"><%= row.target_50.toLocaleString('th-TH') %></td>
                    <td>
                      <div class="target-progress-cell">
                        <strong><%= row.telemed_percent.toFixed(2) %>%</strong>
                        <div class="target-progress-track" aria-hidden="true">
                          <span class="target-progress-fill <%= row.telemed_percent >= 50 ? 'passed' : (row.telemed_percent >= 45 ? 'near' : 'failed') %>" style="width: <%= Math.min(row.telemed_percent, 100).toFixed(2) %>%"></span>
                        </div>
                      </div>
                    </td>
                    <td><%= targetDiffLabel(row.diff_from_target) %></td>
                    <td>
                      <span class="target-status <%= row.telemed_total >= row.target_50 ? 'passed' : (row.telemed_percent >= 45 ? 'near' : 'failed') %>">
                        <%= targetStatusLabel(row) %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
              <% if (target.rows.length > 0) { %>
                <tfoot>
                  <tr>
                    <th>รวม</th>
                    <th class="target-detail-column"></th>
                    <th>ทั้งหมด</th>
                    <th></th>
                    <th class="target-detail-column"></th>
                    <th class="target-detail-column"></th>
                    <th><%= target.summary.opd_total.toLocaleString('th-TH') %></th>
                    <th><%= target.summary.telemed_total.toLocaleString('th-TH') %></th>
                    <th class="target-detail-column"><%= target.summary.b2b_total.toLocaleString('th-TH') %></th>
                    <th class="target-detail-column"><%= target.summary.b2c_total.toLocaleString('th-TH') %></th>
                    <th class="target-detail-column"><%= target.summary.target_50_total.toLocaleString('th-TH') %></th>
                    <th>
                      <div class="target-progress-cell total">
                        <strong><%= target.summary.telemed_percent.toFixed(2) %>%</strong>
                        <div class="target-progress-track" aria-hidden="true">
                          <span class="target-progress-fill <%= target.summary.telemed_percent >= 50 ? 'passed' : (target.summary.telemed_percent >= 45 ? 'near' : 'failed') %>" style="width: <%= Math.min(target.summary.telemed_percent, 100).toFixed(2) %>%"></span>
                        </div>
                      </div>
                    </th>
                    <th><%= targetDiffLabel(target.summary.diff_from_target) %></th>
                    <th></th>
                  </tr>
                </tfoot>
              <% } %>
            </table>
          </div>
        </section>
      </section>
    </main>
  </div>

  <div id="executivePayload" hidden><%= JSON.stringify({ metrics, channel: data.channel, target, filters }) %></div>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script src="/js/executive.js?v=<%= assetVersion %>"></script>
</body>
</html>
